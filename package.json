{
  "name": "@portabyte/node",
  "version": "0.0.3",
  "description": "Official Node.js SDK for Portabyte file infrastructure.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portabyte/node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/portabyte/node-sdk/issues"
  },
  "homepage": "https://github.com/portabyte/node-sdk#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "assets",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run test && pnpm run typecheck"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "~10.1.8",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.2.4"
  }
}
